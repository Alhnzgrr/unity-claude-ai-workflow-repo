  {
    "name": "check-coroutine blocks StartCoroutine",
    "hook": ".claude/hooks/check-coroutine.sh",
    "expectedExit": 2,
    "expectStderr": "HOOK BLOCK [check-coroutine]",
    "input": {
      "tool_name": "Write",
      "tool_input": {
        "file_path": "Assets/Scripts/Loader.cs",
        "content": "using System.Collections;\nusing UnityEngine;\npublic sealed class Loader : MonoBehaviour { void Start() { StartCoroutine(Load()); } IEnumerator Load() { yield return null; } }"
      }
    }
  },
  {
    "name": "check-coroutine allows UniTask",
    "hook": ".claude/hooks/check-coroutine.sh",
    "expectedExit": 0,
    "input": {
      "tool_name": "Write",
      "tool_input": {
        "file_path": "Assets/Scripts/Loader.cs",
        "content": "using Cysharp.Threading.Tasks;\npublic sealed class Loader { public async UniTask LoadAsync() { await UniTask.Yield(); } }"
      }
    }
  },
