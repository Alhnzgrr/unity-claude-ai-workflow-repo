[
  {
    "name": "block-scene-edit blocks scene files",
    "hook": ".claude/hooks/block-scene-edit.sh",
    "expectedExit": 2,
    "expectStderr": "HOOK BLOCK [block-scene-edit]",
    "input": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "Assets/Scenes/Game.unity",
        "old_string": "old",
        "new_string": "new"
      }
    }
  },
  {
    "name": "block-scene-edit allows C# files",
    "hook": ".claude/hooks/block-scene-edit.sh",
    "expectedExit": 0,
    "input": {
      "tool_name": "Write",
      "tool_input": {
        "file_path": "Assets/Scripts/Player.cs",
        "content": "public sealed class Player {}"
      }
    }
  },
  {
